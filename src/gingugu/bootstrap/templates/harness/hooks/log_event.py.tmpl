# /// script
# requires-python = ">=3.8"
# dependencies = []
# ///
# gingugu-init:managed-file - regenerated by `gingugu harness`; local edits are lost on --force
"""Event logger - appends one JSON line per hook event.

Reads the event payload on stdin and appends it, plus a ``logged_at`` timestamp,
to ``<project>/logs/<event_name_in_snake_case>.jsonl``. The project is
``$CLAUDE_PROJECT_DIR``, falling back to the current directory.

Installed by `gingugu harness`. Pure stdlib. Never fails the session: any
problem (bad payload, unwritable disk) exits 0 with no output.
"""

import json
import os
import re
import sys
from datetime import datetime


def snake_case(name: str) -> str:
    """PostToolUse -> post_tool_use."""
    return re.sub(r"(?<!^)(?=[A-Z])", "_", name).lower()


def main() -> None:
    try:
        data = json.loads(sys.stdin.read())
        if not isinstance(data, dict):
            return
        event = snake_case(str(data.get("hook_event_name") or "unknown"))
        event = re.sub(r"[^a-z0-9_]", "", event) or "unknown"
        data["logged_at"] = datetime.now().isoformat()
        project = os.environ.get("CLAUDE_PROJECT_DIR") or os.getcwd()
        log_dir = os.path.join(project, "logs")
        os.makedirs(log_dir, exist_ok=True)
        with open(os.path.join(log_dir, f"{event}.jsonl"), "a") as handle:
            handle.write(json.dumps(data) + "\n")
    except Exception:
        pass


if __name__ == "__main__":
    main()
    sys.exit(0)
