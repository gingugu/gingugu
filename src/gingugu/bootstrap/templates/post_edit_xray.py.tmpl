#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
# gingugu-init:managed-file - regenerated by `gingugu init`; local edits are lost on --force
"""Gingugu PostToolUse hook: the note after an edit (X-ray tuned).

The edit tripwire denies only a blind edit; after an Edit, Write or MultiEdit
this adds, next to the tool result, who calls the definitions the edit touched
and the tests nearest them. It informs and never blocks.
The work itself lives in the installed `gingugu` package (`gingugu hook edit`) so it can be unit-tested; this file is
only the doorway.

The pre-filter here is pure stdlib so the common case costs bare interpreter
startup: any tool other than an edit is dropped before the package is
ever loaded.

Never fails. Any error exits 0 and the call proceeds in silence.
"""

import json
import shutil
import subprocess
import sys

WATCHED = {"Edit", "Write", "MultiEdit"}


def main() -> None:
    try:
        raw = sys.stdin.read()
        payload = json.loads(raw or "{}")
        if not isinstance(payload, dict):
            sys.exit(0)

        if str(payload.get("tool_name") or "") not in WATCHED:
            sys.exit(0)

        if shutil.which("gingugu") is None:
            sys.exit(0)

        result = subprocess.run(
            ["gingugu", "hook", "edit"],
            input=raw,
            capture_output=True,
            text=True,
            timeout=10,
        )
        if result.returncode == 0 and result.stdout.strip():
            print(result.stdout.strip())
    except Exception:
        # A hook must never break the session.
        pass
    sys.exit(0)


if __name__ == "__main__":
    main()
