#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = []
# ///
# gingugu-init:managed-file - regenerated by `gingugu init`; local edits are lost on --force
"""Gingugu PostToolUse hook: the X-ray of what a shell command wrote (X15).

The edit tripwire speaks before an Edit or Write; a `sed -i` or a codegen script
writes behind its back. After a Bash call this adds, next to the tool result,
what each source file the command changed reaches. It informs and never blocks.
The work itself lives in the installed `gingugu` package (`gingugu hook bash`) so it can be unit-tested; this file is
only the doorway.

The pre-filter here is pure stdlib so the common case costs bare interpreter
startup: any tool other than Bash is dropped before the package is
ever loaded.

Never fails. Any error exits 0 and the call proceeds in silence.
"""

import json
import shutil
import subprocess
import sys

WATCHED = {"Bash"}


def main() -> None:
    try:
        raw = sys.stdin.read()
        payload = json.loads(raw or "{}")
        if not isinstance(payload, dict):
            sys.exit(0)

        if str(payload.get("tool_name") or "") not in WATCHED:
            sys.exit(0)

        if shutil.which("gingugu") is None:
            sys.exit(0)

        result = subprocess.run(
            ["gingugu", "hook", "bash"],
            input=raw,
            capture_output=True,
            text=True,
            timeout=10,
        )
        if result.returncode == 0 and result.stdout.strip():
            print(result.stdout.strip())
    except Exception:
        # A hook must never break the session.
        pass
    sys.exit(0)


if __name__ == "__main__":
    main()
